FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata bash \
  && addgroup -S morph \
  && adduser -S -G morph -h /app morph \
  && mkdir -p /app/.morph \
  && chown -R morph:morph /app

COPY mistermorph /usr/local/bin/mistermorph

USER morph
WORKDIR /app

EXPOSE 8787

ENTRYPOINT ["mistermorph"]
